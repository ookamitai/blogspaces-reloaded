<%
const papers = site.data.papers.papers;
const paper = papers.find(item => item.id === page.paper_id);
const position = papers.indexOf(paper);
const related = papers.filter(item => item.id !== paper.id && item.topics.some(topic => paper.topics.includes(topic)))
  .sort((a, b) => b.topics.filter(topic => paper.topics.includes(topic)).length - a.topics.filter(topic => paper.topics.includes(topic)).length).slice(0, 3);
%>
<article class="papers-shell paper-note article" data-paper-note data-paper-id="<%= paper.id %>">
  <div class="article-inner paper-note-inner">
    <nav class="paper-breadcrumb" aria-label="论文导航"><a href="<%- url_for('/papers/') %>">← 全部论文</a><a href="<%- url_for('/papers/guide/') %>">自学路线</a></nav>
    <header class="paper-note-header article-header">
      <h1 class="article-title"><%= paper.title %></h1>
      <p class="article-subtitle">阅读顺序 <%= String(paper.reading_order).padStart(3, '0') %> · <%= paper.stage %> · <%= paper_verification_label(paper.verification) %></p>
      <% if (paper.original_title && paper.original_title !== paper.title) { %><p class="paper-original-title">原清单题名：<%= paper.original_title %></p><% } %>
      <div class="paper-note-actions"><% if (paper.source_url) { %><a class="paper-source-link" href="<%= paper.source_url %>" target="_blank" rel="noopener noreferrer">阅读原文 ↗</a><% } %><button type="button" id="paper-mark-read" aria-pressed="false" hidden>标记为已读</button><span id="paper-save-status" role="status" aria-live="polite"></span></div>
    </header>
    <details class="paper-evidence"><summary>来源与核验</summary><p><%= paper.verification_note %></p><p class="paper-source-refs">原清单位置：<%= paper.source_refs.join('；') %> · 整理于 <%= site.data.papers.updated %></p></details>
    <details class="paper-toc"><summary>本篇目录</summary><%- toc(page.content, {list_number: false, max_depth: 2}) %></details>
    <div class="article-entry paper-note-body"><%- page.content %></div>
    <aside class="paper-related"><h2>接着读</h2><ul><% related.forEach(item => { %><li><a href="<%- url_for('/papers/' + item.slug + '/') %>"><%= item.title %></a></li><% }); %></ul></aside>
    <nav class="paper-pagination" aria-label="前后篇笔记"><% if (position > 0) { %><a href="<%- url_for('/papers/' + papers[position - 1].slug + '/') %>">← 上一篇 <span><%= papers[position - 1].title %></span></a><% } %><% if (position < papers.length - 1) { %><a href="<%- url_for('/papers/' + papers[position + 1].slug + '/') %>">下一篇 → <span><%= papers[position + 1].title %></span></a><% } %></nav>
  </div>
</article>
